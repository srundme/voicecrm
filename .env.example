# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — Railway provides this automatically when you
# add the Postgres plugin; copy the value from Railway → Variables tab.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Node environment — set to "production" on Railway
NODE_ENV=production

# Port — Railway injects this automatically, do NOT set manually on Railway
PORT=8080

# ── Bolna (AI Voice Calling) ───────────────────────────────────────────────────
# Found in your Bolna dashboard → Settings → API Keys
BOLNA_API_KEY=

# ── Brevo (Transactional Email) ────────────────────────────────────────────────
# Found in Brevo dashboard → Settings → SMTP & API → API Keys
BREVO_API_KEY=

# ── Internal secrets ──────────────────────────────────────────────────────────
# Random string used to authenticate Bolna's /api/context webhook calls
# Generate with: openssl rand -hex 32
CONTEXT_API_BEARER_TOKEN=
